<?xml version="1.0" ?>
<robot name="turtlebot3_waffle" xmlns:xacro="http://ros.org/wiki/xacro">
  
  <xacro:arg name="namespace" default=""/>
  <xacro:property name="namespace" value="$(arg namespace)"/>
  
  <material name="black">
      <color rgba="0.0 0.0 0.0 1.0"/>
  </material>

  <material name="dark">
    <color rgba="0.3 0.3 0.3 1.0"/>
  </material>

  <material name="light_black">
    <color rgba="0.4 0.4 0.4 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>

  <material name="grey">
    <color rgba="0.5 0.5 0.5 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.4235 0.0392 1.0"/>
  </material>

  <material name="brown">
    <color rgba="0.8706 0.8118 0.7647 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.0 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>

  <link name="${namespace}base_footprint"/>

  <joint name="${namespace}base_joint" type="fixed">
    <parent link="${namespace}base_footprint"/>
    <child link="${namespace}base_link" />
    <origin xyz="0 0 0.025" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}base_link">
    <visual>
      <origin xyz="-0.16 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/bases/waffle_base.stl" scale="0.0025 0.0025 0.0025"/>
      </geometry>
      <material name="light_black"/>
    </visual>

    <collision>
      <origin xyz="-0.16 0 0.1175" rpy="0 0 0"/>
      <geometry>
        <box size="0.665 0.665 0.235"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="21.4517125"/>
      <inertia ixx="0.849635918" ixy="-0.004646150684" ixz="0.0108989248"
               iyy="0.8417521289" iyz="-0.0003459208887"
               izz="1.427024121" />
    </inertial>
  </link>

  <joint name="${namespace}wheel_left_joint" type="continuous">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}wheel_left_link"/>
    <origin xyz="0 0.36 0.0575" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${namespace}wheel_left_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/wheels/left_tire.stl" scale="0.0025 0.0025 0.0025"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.0825"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.4452959375" />
      <inertia ixx="0.001091365234" ixy="-4.137674121e-09" ixz="-5.798995996e-07"
               iyy="0.001093009082" iyz="-1.406260449e-09"
               izz="0.002022710742" />
      </inertial>
  </link>

  <joint name="${namespace}wheel_right_joint" type="continuous">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}wheel_right_link"/>
    <origin xyz="0 -0.36 0.0575" rpy="-1.57 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="${namespace}wheel_right_link">
    <visual>
      <origin xyz="0 0 0" rpy="1.57 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/wheels/right_tire.stl" scale="0.0025 0.0025 0.0025"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.045" radius="0.0825"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.4452959375" />
      <inertia ixx="0.001091365234" ixy="-4.137674121e-09" ixz="-5.798995996e-07"
               iyy="0.001093009082" iyz="-1.406260449e-09"
               izz="0.002022710742" />
      </inertial>
  </link>

  <joint name="${namespace}caster_back_right_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}caster_back_right_link"/>
    <origin xyz="-0.4425 -0.16 -0.01" rpy="-1.57 0 0"/>
  </joint>

  <link name="${namespace}caster_back_right_link">
    <collision>
      <origin xyz="0 0.0025 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.0225 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.078125" />
      <inertia ixx="0.09765625" ixy="0" ixz="0"
               iyy="0.09765625" iyz="0"
               izz="0.09765625" />
    </inertial>
  </link>

  <joint name="${namespace}caster_back_left_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}caster_back_left_link"/>
    <origin xyz="-0.4425 0.16 -0.01" rpy="-1.57 0 0"/>
  </joint>

  <link name="${namespace}caster_back_left_link">
    <collision>
      <origin xyz="0 0.0025 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.075 0.0225 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" />
      <mass value="0.078125" />
      <inertia ixx="0.09765625" ixy="0" ixz="0"
               iyy="0.09765625" iyz="0"
               izz="0.09765625" />
    </inertial>
  </link>

  <joint name="${namespace}imu_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}imu_link"/>
    <origin xyz="0 0 0.17" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}imu_link"/>

  <joint name="${namespace}scan_joint" type="fixed">
    <parent link="${namespace}base_link"/>
    <child link="${namespace}base_scan"/>
    <origin xyz="-0.16 0 0.305" rpy="0 0 0"/>
  </joint>

  <link name="${namespace}base_scan">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://turtlebot3_description/meshes/sensors/lds.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark"/>
    </visual>

    <collision>
      <origin xyz="0.0375 0 -0.01625" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.0315" radius="0.055"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.114" />
      <origin xyz="0 0 0" />
      <inertia ixx="0.001" ixy="0.0" ixz="0.0"
               iyy="0.001" iyz="0.0"
               izz="0.001" />
    </inertial>
  </link>

  <joint name="${namespace}camera_joint" type="fixed">
    <origin xyz="0.16 -0.1625 0.235" rpy="0 0 0"/>
    <parent link="${namespace}base_link"/>
    <child link="${namespace}camera_link"/>
  </joint>

  <link name="${namespace}camera_link">
    <visual>
     <origin xyz="0 0 0" rpy="1.57 0 1.57"/>
      <geometry>
       <mesh filename="package://turtlebot3_description/meshes/sensors/r200.dae" />
      </geometry>
    </visual>
    <collision>
      <origin xyz="0.0075 0.1625 0.0175" rpy="0 0 0"/>
      <geometry>
        <box size="0.012 0.132 0.020"/>
      </geometry>
    </collision>

    

  </link>

  <joint name="${namespace}camera_rgb_joint" type="fixed">
    <origin xyz="0.0125 0.045 0.0325" rpy="0 0 0"/>
    
    <parent link="${namespace}camera_link"/>
    <child link="${namespace}camera_rgb_frame"/>
  </joint>
  <link name="${namespace}camera_rgb_frame"/>

  <joint name="${namespace}camera_rgb_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="${namespace}camera_rgb_frame"/>
    <child link="${namespace}camera_rgb_optical_frame"/>
  </joint>
  <link name="${namespace}camera_rgb_optical_frame"/>

  <joint name="${namespace}camera_depth_joint" type="fixed">
    <origin xyz="0.0125 0.07 0.0325" rpy="0 0 0"/>
    
    <parent link="${namespace}camera_link"/>
    <child link="${namespace}camera_depth_frame"/>
  </joint>
  <link name="${namespace}camera_depth_frame"/>

  <joint name="${namespace}camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.57 0 -1.57"/>
    <parent link="${namespace}camera_depth_frame"/>
    <child link="${namespace}camera_depth_optical_frame"/>
  </joint>
  <link name="${namespace}camera_depth_optical_frame"/>

    <!-- Gazebo visual appearance -->
  <gazebo reference="${namespace}base_link">
    <material>Gazebo/DarkGrey</material>
  </gazebo>

  <gazebo reference="${namespace}wheel_left_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="${namespace}wheel_right_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="${namespace}caster_back_left_link">
    <material>Gazebo/Black</material>
  </gazebo>

  <gazebo reference="${namespace}caster_back_right_link">
    <material>Gazebo/Black</material>
  </gazebo>

</robot>
